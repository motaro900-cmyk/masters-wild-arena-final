rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ВНИМАНИЕ: В текущей версии игры не используется Firebase Authentication (клиент обращается напрямую без signIn).
    // Правила типа `request.auth != null` заблокируют все сохранения игроков.
    // После перехода на Cloud Functions (Этап 4) прямая запись из клиента в `/пользователи` будет запрещена (write: if false),
    // а все сохранения будут идти через защищенный серверный Admin SDK.
    
    match /пользователи/{userId} {
      allow read: if true;
      allow write: if userId.matches('VK-.*') || userId.matches('GUEST-.*') || userId == 'DEVELOPER';
      allow delete: if false;

      match /почта/{mailId} {
        allow read, create, update: if true;
        allow delete: if false;
      }
      
      match /запросы/{requestId} {
        allow read, create, update: if true;
        allow delete: if false;
      }
    }

    match /пользователи_dev/{userId} {
      allow read: if true;
      allow write: if userId.matches('VK-.*') || userId.matches('GUEST-.*') || userId == 'DEVELOPER';
      allow delete: if false;

      match /почта/{mailId} {
        allow read, create, update: if true;
        allow delete: if false;
      }
      
      match /запросы/{requestId} {
        allow read, create, update: if true;
        allow delete: if false;
      }
    }

    match /чат/{messageId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /чат_dev/{messageId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /отзывы/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /отзывы_dev/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
