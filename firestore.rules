rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Профили игроков: любой может читать (для лидерборда/просмотра), но писать только владелец аккаунта
    match /пользователи/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Личные входящие письма: доступ только владельцу
      match /почта/{mailId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Запросы в друзья: доступ только владельцу
      match /запросы/{requestId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Глобальный чат: читать могут все, писать только авторизованные, редактировать/удалять нельзя
    match /чат/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Баг-репорты и отзывы: отправлять (создавать) может любой, читать/изменять нельзя (только админу через панель Firebase)
    match /отзывы/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
