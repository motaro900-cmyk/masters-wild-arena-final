rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ВНИМАНИЕ: В текущей версии игры не используется Firebase Authentication (клиент обращается напрямую без signIn).
    // Правила типа `request.auth != null` заблокируют все сохранения игроков.
    // После перехода на Cloud Functions (Этап 4) прямая запись из клиента в `/пользователи` будет запрещена (write: if false),
    // а все сохранения будут идти через защищенный серверный Admin SDK.
    
    match /пользователи/{userId} {
      allow read, write: if true; // Временно разрешено, пока сохранение идет напрямую с клиента

      match /почта/{mailId} {
        allow read, write: if true;
      }
      
      match /запросы/{requestId} {
        allow read, write: if true;
      }
    }

    match /чат/{messageId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /отзывы/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
