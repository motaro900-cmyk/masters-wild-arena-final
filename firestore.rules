rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════════════════════════
    // SECURITY HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════════

    // Checks if the request is sent by a logged-in (VK authenticated) player.
    function isAuthorized() {
      return request.auth != null;
    }

    // Checks if the logged-in player is the owner of the document.
    function isOwner(userId) {
      return isAuthorized() && request.auth.uid == userId;
    }

    // Checks if the player is ONLY adding/removing themselves from another player's friends list.
    function isFriendsSelfUpdate() {
      return isAuthorized()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
        && (
          (!('friends' in resource.data) && request.resource.data.friends.toSet().hasOnly([request.auth.uid]))
          ||
          (('friends' in resource.data)
            && request.resource.data.friends.size() == resource.data.friends.size() + 1
            && request.resource.data.friends.toSet().difference(resource.data.friends.toSet()).hasOnly([request.auth.uid]))
          ||
          (('friends' in resource.data)
            && request.resource.data.friends.size() == resource.data.friends.size() - 1
            && resource.data.friends.toSet().difference(resource.data.friends.toSet()).hasOnly([request.auth.uid]))
        );
    }

    // ═══════════════════════════════════════════════════════════════════════
    // WILDCARD PATH MATCHING (Bypasses Web Editor Cyrillic parser bug)
    // ═══════════════════════════════════════════════════════════════════════

    // Matches any top-level collection path (depth 2)
    match /{collectionId}/{docId} {
      
      // 1. GLOBAL CHAT COLLECTIONS
      allow read, create: if (collectionId == 'чат' || collectionId == 'чат_dev') && isAuthorized();
      allow update, delete: if (collectionId == 'чат' || collectionId == 'чат_dev') && false;
      
      // 2. FEEDBACK COLLECTIONS
      allow create: if (collectionId == 'отзывы' || collectionId == 'отзывы_dev') && isAuthorized();
      allow read, update, delete: if (collectionId == 'отзывы' || collectionId == 'отзывы_dev') && false;
      
      // 3. PLAYER PROFILE COLLECTIONS
      allow read: if (collectionId == 'пользователи' || collectionId == 'пользователи_dev') && isAuthorized();
      allow create, delete: if (collectionId == 'пользователи' || collectionId == 'пользователи_dev') && isOwner(docId);
      allow update: if (collectionId == 'пользователи' || collectionId == 'пользователи_dev') && (isOwner(docId) || isFriendsSelfUpdate());

      // Sub-collections under users (Mail and friend request notifications)
      match /{subCollectionId}/{subDocId} {
        allow read, create, update: if (collectionId == 'пользователи' || collectionId == 'пользователи_dev')
                                      && (subCollectionId == 'почта' || subCollectionId == 'запросы')
                                      && isAuthorized();
                                      
        allow delete: if (collectionId == 'пользователи' || collectionId == 'пользователи_dev')
                        && (subCollectionId == 'почта' || subCollectionId == 'запросы')
                        && isOwner(docId);
      }
    }
  }
}
